#!/usr/bin/env python3

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

VERSION = "0.1.0"

USAGE = "usage: mytools <command> [options]"


def _commands():
    from mytools_lib import merge

    return {
        "merge": merge.main,
    }


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2

    if argv[0] == "--version":
        print(f"mytools {VERSION}")
        return 0

    cmd, rest = argv[0], argv[1:]
    handler = _commands().get(cmd)
    if handler is None:
        print(USAGE, file=sys.stderr)
        print(f"mytools: unknown command: {cmd}", file=sys.stderr)
        return 2

    return handler(rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
