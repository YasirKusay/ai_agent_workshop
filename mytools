#!/usr/bin/env python3

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

VERSION = "0.1.0"

COMMANDS = {}

try:
    from mytools_lib.intersect import main as _intersect_main

    COMMANDS["intersect"] = _intersect_main
except ImportError:
    pass


def main(argv):
    if not argv:
        print("usage: mytools <command> [options]", file=sys.stderr)
        return 2

    if argv[0] == "--version":
        print(f"mytools {VERSION}")
        return 0

    if argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:])

    print("usage: mytools <command> [options]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
