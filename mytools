#!/usr/bin/env python3

import sys

VERSION = "0.1.0"


def main(argv):
    if not argv:
        print("usage: mytools <command> [options]", file=sys.stderr)
        return 2

    if argv[0] == "--version":
        print(f"mytools {VERSION}")
        return 0

    print("usage: mytools <command> [options]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
